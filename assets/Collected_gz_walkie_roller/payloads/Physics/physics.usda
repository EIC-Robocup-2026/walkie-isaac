    over "Physics"
    {
        def PhysicsPrismaticJoint "lift_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 10000
            float newton:velocityLimit = 0.1
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </walkie_bot/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </walkie_bot/Geometry/base_footprint/base_link/lift_link>
            point3f physics:localPos0 = (-0.07, 0, 1.142)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.7435
            float physics:upperLimit = 0
            custom float urdf:limit:effort = 10000
        }

        def PhysicsRevoluteJoint "bl_wheel_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 100
            float newton:damping = 0.08726646
            float newton:friction = 0.5
            float newton:velocityLimit = 5729.578
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </walkie_bot/Geometry/base_footprint/base_link>
            custom rel physics:body1
            append rel physics:body1 = </walkie_bot/Geometry/base_footprint/base_link/bl_wheel_link>
            point3f physics:localPos0 = (-0.130943, 0.130943, 0.05)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9238795, 0, 0, 0.38268352)
